// 19 - Vector math on a hot path (ray/sphere hit test).
// Features: Copy value types (no heap, no aliasing), operator-style methods,
//           inline arithmetic, boolean logic. Represents the perf-sensitive core.

package examples;

public data class Vec3(x: Double, y: Double, z: Double) : Copy {
    public fun add(o: Vec3): Vec3 { return Vec3(x + o.x, y + o.y, z + o.z); }
    public fun sub(o: Vec3): Vec3 { return Vec3(x - o.x, y - o.y, z - o.z); }
    public fun scale(k: Double): Vec3 { return Vec3(x * k, y * k, z * k); }
    public fun dot(o: Vec3): Double { return x * o.x + y * o.y + z * o.z; }
}

public data class Ray(origin: Vec3, direction: Vec3) : Copy;
public data class Sphere(center: Vec3, radius: Double) : Copy;

// Returns true if the ray hits the sphere (all Copy values, zero allocation).
public fun hits(ray: Ray, sphere: Sphere): Bool {
    oc: Vec3 = ray.origin.sub(sphere.center);
    a: Double = ray.direction.dot(ray.direction);
    b: Double = 2.0 * oc.dot(ray.direction);
    c: Double = oc.dot(oc) - sphere.radius * sphere.radius;
    discriminant: Double = b * b - 4.0 * a * c;
    return discriminant >= 0.0;
}

public fun main(): Unit {
    ray: Ray = Ray(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0));
    near: Sphere = Sphere(Vec3(0.0, 0.0, -5.0), 1.0);
    far: Sphere  = Sphere(Vec3(9.0, 9.0, -5.0), 1.0);
    println("hits near = ${hits(ray, near)}");
    println("hits far  = ${hits(ray, far)}");
}
