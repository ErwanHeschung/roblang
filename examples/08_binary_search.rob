// 08 - Binary search returning an optional index.
// Features: T? / Option for "not found", existence check (never null-as-value),
//           mut locals, ranges, while loop.

package examples;

// Returns the index of 'target' in the sorted list, or absent if missing.
public fun binarySearch(sorted: List<Int>, target: Int): Int? {
    mut low: Int = 0;
    mut high: Int = sorted.size() - 1;
    while (low <= high) {
        mid: Int = low + (high - low) / 2;
        value: Int = sorted.get(mid);
        if (value == target) {
            return mid;               // widens to Int? as Some(mid)
        } else if (value < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return null;                       // None: not found
}

public fun main(): Unit {
    data: List<Int> = List.of(1, 3, 5, 7, 9, 11);
    match (binarySearch(data, 7)) {
        Some(i) -> println("found at index ${i}"),
        None    -> println("not found")
    };
    match (binarySearch(data, 8)) {
        Some(i) -> println("found at index ${i}"),
        None    -> println("not found")
    };
}
